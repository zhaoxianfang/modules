<?php

namespace {{NAMESPACE}}\{{NAME}}\Models;

use Illuminate\Database\Eloquent\Builder;
use Illuminate\Database\Eloquent\Casts\Attribute;
use Illuminate\Database\Eloquent\Model;
use Illuminate\Database\Eloquent\Relations\BelongsTo;
use Illuminate\Database\Eloquent\Relations\HasMany;
use Illuminate\Support\Carbon;

/**
 * {{CLASS}} 模型
 *
 * {{NAME}} 模块的数据模型，继承 Eloquent Model。
 * 按 Laravel 13 官方风格生成（casts() 方法、无冗余默认属性、现代访问器 API）。
 *
 * 常用示例：
 * ```php
 * // 新增记录
 * {{CLASS}}::query()->create(['name' => '示例']);
 *
 * // 查询并分页
 * {{CLASS}}::query()->active()->paginate(15);
 * ```
 *
 * @property int|null $id 主键 ID
 * @property string|null $name 名称
 * @property string|null $status 状态（active/inactive）
 * @property Carbon|null $created_at 创建时间
 * @property Carbon|null $updated_at 更新时间
 */
class {{CLASS}} extends Model
{
    /**
     * 数据表名称
     *
     * 模块迁移生成的数据表为「单数小写」（如 blog），
     * 而 Eloquent 默认按类名复数蛇形推导（Blog => blogs），
     * 故必须显式声明，否则会查询到错误的表。
     *
     * @var string
     */
    protected $table = '{{LOWER_NAME}}';

    /**
     * 可批量赋值的属性（Laravel 11+ 默认 $guarded = ['*']，此处显式放开）
     *
     * 只有列入此数组的字段才能通过 create()/update()/fill() 批量赋值，
     * 防止用户提交意外的字段（Mass Assignment）。
     *
     * @var array<int, string>
     */
    protected $fillable = [
        'name',
        'status',
    ];

    /**
     * 属性类型转换（Laravel 11+ 方法形式，替代旧的 $casts 属性）
     *
     * 支持：int / float / string / bool / object / array / collection /
     *       date / datetime / immutable_date / encrypted / enum 等。
     *
     * @return array<string, string>
     */
    protected function casts(): array
    {
        return [
            'created_at' => 'datetime',
            'updated_at' => 'datetime',
        ];
    }

    /*
    |--------------------------------------------------------------------------
    | 查询作用域（Scopes）
    |--------------------------------------------------------------------------
    | 通过 ->active() 等方式复用的查询条件
    */

    /**
     * 只查询已激活的记录
     *
     * @param  Builder<\zxf\Modules\{{NAME}}\Models\{{CLASS}}>  $query
     * @return Builder<\zxf\Modules\{{NAME}}\Models\{{CLASS}}>
     */
    public function scopeActive(Builder $query): Builder
    {
        return $query->where('status', 'active');
    }

    /**
     * 按名称模糊搜索
     *
     * @param  Builder<\zxf\Modules\{{NAME}}\Models\{{CLASS}}>  $query
     * @param  string  $keyword 搜索关键词
     * @return Builder<\zxf\Modules\{{NAME}}\Models\{{CLASS}}>
     */
    public function scopeSearch(Builder $query, string $keyword): Builder
    {
        return $query->where('name', 'like', "%{$keyword}%");
    }

    /*
    |--------------------------------------------------------------------------
    | 访问器与修改器（Accessors & Mutators）
    |--------------------------------------------------------------------------
    | 使用 Laravel 9+ 的 Attribute API，推荐方法形式定义
    */

    /**
     * 是否激活（现代访问器 API）
     *
     * 获取时：$model->is_active 自动调用 get 闭包
     * 设置时：$model->is_active = true 自动调用 set 闭包
     *
     * @return Attribute<bool, bool>
     */
    protected function isActive(): Attribute
    {
        return Attribute::make(
            get: fn (): bool => $this->status === 'active',
            set: fn (bool $value): string => $value ? 'active' : 'inactive',
        );
    }

    /*
    |--------------------------------------------------------------------------
    | 模型关联（Relations）
    |--------------------------------------------------------------------------
    | 按需取消注释并修改为真实关联
    */

    /**
     * 一对多关联示例：属于该作者的文章列表
     *
     * @return HasMany<\zxf\Modules\{{NAME}}\Models\Post>
     */
    // public function posts(): HasMany
    // {
    //     return $this->hasMany(Post::class, 'author_id');
    // }

    /**
     * 反向一对多关联示例：归属的用户
     *
     * @return BelongsTo<\zxf\Modules\User\Models\User>
     */
    // public function user(): BelongsTo
    // {
    //     return $this->belongsTo(\zxf\Modules\User\Models\User::class);
    // }

    /*
    |--------------------------------------------------------------------------
    | 其他方法
    |--------------------------------------------------------------------------
    */

    /**
     * 检查记录是否可删除
     *
     * @return bool 是否可以删除
     */
    public function canBeDeleted(): bool
    {
        // TODO: 在此添加业务约束（如存在关联数据时禁止删除）
        return true;
    }
}

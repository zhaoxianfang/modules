<?php

/**
 * {{NAME}} 模块配置文件
 *
 * 此文件是模块的入口配置，所有模块元数据和核心设置均在此定义。
 * 不需要额外的 composer.json 或其他 JSON 文件来管理模块。
 *
 * 此文件会被自动加载并解析，支持以下内置键：
 * - enabled: 是否启用模块
 * - priority: 加载优先级（数字越小越先加载）
 * - description: 模块描述
 * - author: 作者
 * - version: 版本号
 * - aliases: 模块名称别名
 * - providers: 额外需要注册的 Laravel 服务提供者
 * - laravel_aliases: 额外需要注册的 Laravel 门面别名
 * - options: 自定义配置项
 */

return [
    /*
    |--------------------------------------------------------------------------
    | 模块启用状态
    |--------------------------------------------------------------------------
    |
    | 是否启用该模块。设为 false 可禁用模块的所有功能。
    | 使用 module_enabled('{{NAME}}') 或 module('{{NAME}}')->isEnabled() 检测。
    |
    */
    'enabled' => true,

    /*
    |--------------------------------------------------------------------------
    | 模块加载优先级
    |--------------------------------------------------------------------------
    |
    | 数字越小，模块越先加载。相同优先级按模块名称字母序排列。
    | 默认值: 1000
    |
    */
    'priority' => 1000,

    /*
    |--------------------------------------------------------------------------
    | 模块显示名称
    |--------------------------------------------------------------------------
    |
    | 模块的友好名称，用于展示
    |
    */
    'name' => '{{NAME}}',

    /*
    |--------------------------------------------------------------------------
    | 模块版本
    |--------------------------------------------------------------------------
    |
    | 当前模块的版本号
    |
    */
    'version' => '1.0.0',

    /*
    |--------------------------------------------------------------------------
    | 模块描述
    |--------------------------------------------------------------------------
    |
    | 模块的描述信息
    |
    */
    'description' => '{{NAME}} 模块',

    /*
    |--------------------------------------------------------------------------
    | 模块作者
    |--------------------------------------------------------------------------
    |
    | 模块的作者信息
    |
    */
    'author' => '',

    /*
    |--------------------------------------------------------------------------
    | 模块别名
    |--------------------------------------------------------------------------
    |
    | 模块名称的别名列表，可通过别名查找模块。
    | 例如：模块名为 "BlogManager"，可设置别名 ["blog", "blogs"]
    |
    */
    'aliases' => [],

    /*
    |--------------------------------------------------------------------------
    | 额外 Laravel 服务提供者
    |--------------------------------------------------------------------------
    |
    | 模块内需要额外注册的 Laravel 服务提供者类名列表。
    | 注意：主服务提供者（Providers/{Module}ServiceProvider.php）会被自动发现。
    | 当模块需要注册第三方或额外的服务提供者时，在此列出完整类名。
    |
    */
    'providers' => [
        // \Modules\{{NAME}}\Providers\AdditionalServiceProvider::class,
    ],

    /*
    |--------------------------------------------------------------------------
    | 额外 Laravel 门面别名
    |--------------------------------------------------------------------------
    |
    | 模块内需要注册的 Laravel 门面（Facade）别名。
    | 格式：'别名' => '完整类名'
    |
    */
    'laravel_aliases' => [
        // 'ModuleAlias' => \Modules\{{NAME}}\Facades\SomeFacade::class,
    ],

    /*
    |--------------------------------------------------------------------------
    | 模块自定义配置
    |--------------------------------------------------------------------------
    |
    | 模块的自定义配置项，通过以下方式访问：
    | - module_config('key', 'default')               // 自动检测当前模块
    | - module_config('key', 'default', '{{NAME}}')   // 指定模块
    | - module('{{NAME}}')->config('key', 'default')  // 模块实例方式
    |
    | 示例：
    | - 读取配置：module_config('options.cache_ttl', 3600)
    |
    */
    'options' => [
        // 在这里添加自定义配置
        // 示例：'cache_ttl' => 3600,
    ],
];

